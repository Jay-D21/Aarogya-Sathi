# ============================================
# Aarogya Sathi — .gitignore
# ============================================

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
venv/
.venv/
*.egg-info/
dist/

# ── Environment files (SECRETS!) ──
.env
.env.local
.env.production
*.env

# ── Flutter ──
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
*.iml

# ── Build outputs ──
build/
*.apk
*.aab

# ── IDE ──
.vscode/
.idea/
*.swp
*.swo

# ── OS ──
.DS_Store
Thumbs.db

# ── Docker ──
# Don't ignore docker-compose or Dockerfiles (needed for DevOps demo)

# ── Kubernetes secrets (real values) ──
# k8s/secrets.yaml  ← Uncomment in production!

# ── Project specific ──
jenkins-installer.msi
*.msi
*.pptx
.verdent/
.claude/
uploads/
*.log
test.db

# ── Keys ──
*.pem
service-account-key.json

# ── Test artifacts ──
test-results.xml
coverage.xml
htmlcov/
.coverage
.pytest_cache/
