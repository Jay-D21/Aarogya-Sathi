# Stage 1: Build Flutter web (for CI testing)
FROM ghcr.io/cirruslabs/flutter:3.19.0 AS build

WORKDIR /app
COPY pubspec.yaml pubspec.lock ./
RUN flutter pub get

COPY . .
RUN flutter analyze
RUN flutter test
RUN flutter build apk --release

# Stage 2: Extract APK artifact
FROM alpine:3.19 AS artifact
COPY --from=build /app/build/app/outputs/flutter-apk/app-release.apk /output/
CMD ["echo", "APK built successfully. Extract from /output/app-release.apk"]
