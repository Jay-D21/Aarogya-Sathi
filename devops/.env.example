# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Aarogya Sathi — Environment Variables Template
# Copy this file to .env and fill in your values
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ── Application ──
APP_ENV=development           # development | staging | production
APP_DEBUG=true
APP_PORT=8000
APP_NAME=aarogya-sathi

# ── Database (PostgreSQL) ──
DATABASE_URL=postgresql://arogya_user:arogya_dev_password@localhost:5432/arogya_sathi
POSTGRES_PASSWORD=arogya_dev_password
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Cache (Redis) ──
REDIS_URL=redis://localhost:6379/0

# ── Authentication (JWT) ──
JWT_SECRET=CHANGE_ME_to_a_random_256_bit_secret_key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE=3600         # 1 hour (seconds)
JWT_REFRESH_TOKEN_EXPIRE=2592000     # 30 days (seconds)

# ── Google Cloud / Gemini API ──
GOOGLE_API_KEY=your-gemini-api-key-here
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# ── External APIs ──
WAQI_API_KEY=your-waqi-api-key-here
OPENWEATHER_API_KEY=your-openweather-api-key-here

# ── CORS ──
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ── File Storage ──
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# ── Logging ──
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json               # json | text
